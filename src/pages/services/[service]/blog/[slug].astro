---
import { getCollection, render, type CollectionEntry } from "astro:content";
import PageText from "../../../../components/blog/page_text.astro";
import PageImg from "../../../../components/blog/page_img.astro";
import HrLine from "../../../../components/blog/hr_line.astro";
import HrEndline from "../../../../components/blog/hr_endline.astro";
import PageHead from "../../../../components/blog/page_head.astro";
import Base from "../../../../components/layout/base.astro";
import { BLOG_COLLECTION_MAP, type BlogCollectionName } from "../../../../utils/collectionMap.ts";

export async function getStaticPaths() {
  const paths = [];

  for (const serviceKey in BLOG_COLLECTION_MAP) {
    const collectionName = BLOG_COLLECTION_MAP[serviceKey as keyof typeof BLOG_COLLECTION_MAP];
    const posts = await getCollection(collectionName);

    posts.forEach((post) => {
      paths.push({
        params: { service: serviceKey, slug: post.id },
        props: { post },
      });
    });
  }
  return paths;
}

type Props = { post: CollectionEntry<BlogCollectionName> };
const { post } = Astro.props;
const blog_data = post.data.blog_data;

const { Content } = await render(post);




---

<Base>
  <PageHead blog_data={blog_data} />
  <HrLine />
  <article>
    <Content components={{ PageText, PageImg }} />
  </article>
  <HrEndline />
</Base>
