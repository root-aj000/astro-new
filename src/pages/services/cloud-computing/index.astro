---
import ServiceLayout from '../../../components/layout/service_page.astro';
import Base from '../../../components/layout/base.astro';
import { getEntry, getCollection } from 'astro:content'; // Import getCollection

// Fetch the main service page content
const entry = await getEntry("indexPage", "cloud-computing");

if (!entry) {
  throw new Error("Entry for cloud-computing service page not found in 'indexPage' collection");
}
const indexpro = entry.data;
console.log("INDEXPRO", indexpro);
// Fetch blog posts and case studies for Cloud Computing
const allCloudComputingBlogPosts = await getCollection('CloudComputingBlog');
const allCloudComputingCaseStudies = await getCollection('CloudComputingCases');

// Select and limit the posts/cases (example: latest 4 blogs and latest 3 cases)
// You might want to sort by date or a custom field if needed before slicing
const limitedPosts = allCloudComputingBlogPosts.slice(0, 4);
const limitedCases = allCloudComputingCaseStudies.slice(0, 3);
---


  <ServiceLayout
    indexpro={indexpro}
    limitedPosts={limitedPosts}
    limitedCases={limitedCases}
  />

