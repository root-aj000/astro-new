---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import PageText from '../../../../components/blog/page_text.astro'; // Reusing blog components for now
import PageImg from '../../../../components/blog/page_img.astro'; // Reusing blog components for now
import HrLine from '../../../../components/blog/hr_line.astro'; // Reusing blog components for now
import HrEndline from '../../../../components/blog/hr_endline.astro'; // Reusing blog components for now
import PageHead from '../../../../components/blog/page_head.astro'; // Reusing blog component for now, might need a dedicated CaseStudyHead
import Base from '../../../../components/layout/base.astro';

export async function getStaticPaths() {
  // Fetch all case studies from the AichatbotCases collection
  const caseStudies = await getCollection('AichatbotCases');
  return caseStudies.map((caseStudy) => ({
    params: { slug: caseStudy.id }, // Using caseStudy.slug as the slug for the URL
    props: caseStudy,
  }));
}

// Define the type for the page props
type Props = CollectionEntry<'AichatbotCases'>;

// Access the fetched case study data from Astro.props
const caseStudy = Astro.props as Props;

// Extract case_data from the case study data (assuming it's nested)
const case_data = caseStudy.data.case_data;

// Render the MDX content
const { Content } = await render(caseStudy);
---

<Base>
  {/* Pass case_data to PageHead (consider creating a specific CaseStudyHead component) */}
  <PageHead blog_data={case_data} />
  <HrLine />

  {/* The dynamic MDX content with injected components */}
  <article>
    <Content
      components={{
        PageText,
        PageImg,
      }}
    />
  </article>

  <HrEndline />
</Base>