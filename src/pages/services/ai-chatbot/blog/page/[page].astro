---
// Astro frontmatter
import UniversalCard from "../../../../../components/dynamic/universal_card.astro";
import Pagination from "../../../../../components/dynamic/pagination.astro";
import BlogGrid from "../../../../../components/blog/blog-grid.astro";
import Base from "../../../../../components/layout/base.astro";
import { BASE_PATH_CONST, BASE_PATH_BLOG } from "../../../../../content/const.ts";
import { getCollection } from "astro:content";

export async function getStaticPaths() {
  const allBlogPosts = await getCollection("AichatbotBlog");
  const itemsPerPage = 12;
  const totalPages = Math.ceil(allBlogPosts.length / itemsPerPage);

  return Array.from({ length: totalPages }, (_, i) => ({
    params: { page: (i + 1).toString() },
  }));
}

const currentPage = parseInt(Astro.params.page) || 1;
const itemsPerPage = 12;
const allBlogPosts = await getCollection("AichatbotBlog");
const totalItems = allBlogPosts.length;

// Use this for page URLs like /services/ai-chatbot/blog/page/2
const basePath = BASE_PATH_CONST.Aichatbot_blog;

// This is used for card hrefs like /services/ai-chatbot/blog/post-id
const basePathBlog = BASE_PATH_BLOG.Aichatbot_blog;

const paginatedPosts = allBlogPosts
  .filter((post) => post.data && post.data.blog_data)
  .slice((currentPage - 1) * itemsPerPage, currentPage * itemsPerPage);
---

<Base>
  <BlogGrid>
    {
      paginatedPosts.map((post) => (
        <UniversalCard blog_data={{ ...post.data.blog_data, date: new Date(post.data.blog_data.date),  href: `${basePathBlog}/${post.id}` }} />
      ))
    }
  </BlogGrid>

  <Pagination
    currentPage={currentPage}
    totalItems={totalItems}
    itemsPerPage={itemsPerPage}
    basePath={basePath}
  />
</Base>
