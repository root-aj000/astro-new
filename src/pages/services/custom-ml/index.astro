---
import ServiceLayout from '../../../components/layout/service_page.astro';
import Base from '../../../components/layout/base.astro';
import { getEntry, getCollection } from 'astro:content'; // Import getCollection

// Fetch the main service page content
const entry = await getEntry("indexPage", 'services/custom-ml/index');

if (!entry) {
  throw new Error("Entry for custom-ml service page not found in 'indexPage' collection");
}
const indexpro = entry.data;

// Fetch blog posts and case studies for Custom ML
const allCustomMLBlogPosts = await getCollection('CustomMLBlog');
const allCustomMLCaseStudies = await getCollection('CustomMLCases');

// Select and limit the posts/cases (example: latest 4 blogs and latest 3 cases)
// You might want to sort by date or a custom field if needed before slicing
const limitedPosts = allCustomMLBlogPosts.slice(0, 4);
const limitedCases = allCustomMLCaseStudies.slice(0, 3);
---

<Base>
  <ServiceLayout
    indexpro={indexpro}
    limitedPosts={limitedPosts}
    limitedCases={limitedCases}
  />
</Base>
