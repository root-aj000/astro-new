---
import UniversalCard from "../../../../../components/dynamic/universal_card.astro";
import Pagination from "../../../../../components/dynamic/pagination.astro";
import BlogGrid from "../../../../../components/blog/blog-grid.astro";
import ListHeader from "../../../../../components/dynamic/list_header.astro";
import Base from "../../../../../components/layout/base.astro";
import { BASE_PATH_CONST } from "../../../../../content/const.ts";
import { getCollection } from 'astro:content'; // Import getCollection

const currentPage = parseInt(Astro.params.page) || 1;
const itemsPerPage = 12;

// Fetch all blog posts from the CustomMLBlog collection
const allBlogPosts = await getCollection('CustomMLBlog');

// Calculate total items based on the fetched collection
const totalItems = allBlogPosts.length;

const basePath = BASE_PATH_CONST.CustomML_blog; // Ensure this constant is defined and correct

// Slice the fetched collection for pagination
const paginatedPosts = allBlogPosts.slice(
  (currentPage - 1) * itemsPerPage,
  currentPage * itemsPerPage
);

// Define data for the ListHeader (example data - you might want to fetch this from elsewhere)
const listHeaderData = {
  title: "Custom ML Blog",
  discription: "Latest articles and insights on Custom Machine Learning.",
};
---

<Base>
  {/* Pass data to the ListHeader */}
  <ListHeader list_header={listHeaderData} />
  <BlogGrid>
    {/* Pass fetched collection entries to UniversalCard */}
    {paginatedPosts.map((post) => <UniversalCard blog_data={post.data.blog_data} />)} {/* Assuming blog_data is nested in post.data */}
  </BlogGrid>
  <Pagination
    currentPage={currentPage}
    totalItems={totalItems}
    itemsPerPage={itemsPerPage}
    basePath={basePath}
  />
</Base>
