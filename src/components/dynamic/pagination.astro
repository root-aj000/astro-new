---
export interface Props {
  currentPage: number;
  totalItems: number;
  itemsPerPage: number;
  basePath: string; // e.g., "/services/ai-chatbot/blog"
}

const { currentPage, totalItems, itemsPerPage, basePath } = Astro.props;

const totalPages = Math.ceil(totalItems / itemsPerPage);

const visibleRange = 5;
const halfRange = Math.floor(visibleRange / 2);

let startPage = Math.max(1, currentPage - halfRange);
let endPage = Math.min(totalPages, startPage + visibleRange - 1);

if (endPage - startPage + 1 < visibleRange) {
  startPage = Math.max(1, endPage - visibleRange + 1);
}

const pagesToShow = Array.from(
  { length: endPage - startPage + 1 },
  (_, i) => startPage + i
);

function getPageUrl(page: number) {
  return `${basePath}/page/${page}`;
}
---

<nav aria-label="Pagination" class="flex justify-center mt-10">
  <ul class="flex items-center space-x-2 text-sm">
    <!-- Prev -->
    {
      currentPage > 1 && (
        <li>
          <a href={getPageUrl(currentPage - 1)} class="px-3 py-1 border rounded hover:bg-gray-100">Prev</a>
        </li>
      )
    }

    <!-- First -->
    {
      startPage > 1 && (
        <li>
          <a href={getPageUrl(1)} class="px-3 py-1 border rounded hover:bg-gray-100">1</a>
        </li>
      )
    }

    <!-- Left Ellipsis -->
    {
      startPage > 2 && (
        <li><span class="px-2">…</span></li>
      )
    }

    <!-- Pages -->
    {
      pagesToShow.map(page => (
        <li>
          <a
            href={getPageUrl(page)}
            aria-current={page === currentPage ? "page" : undefined}
            class={`px-3 py-1 border rounded ${
              page === currentPage ? "bg-orange-500 text-white border-orange-600" : "hover:bg-gray-100"
            }`}
          >
            {page}
          </a>
        </li>
      ))
    }

    <!-- Right Ellipsis -->
    {
      endPage < totalPages - 1 && (
        <li><span class="px-2">…</span></li>
      )
    }

    <!-- Last -->
    {
      endPage < totalPages && (
        <li>
          <a href={getPageUrl(totalPages)} class="px-3 py-1 border rounded hover:bg-gray-100">
            {totalPages}
          </a>
        </li>
      )
    }

    <!-- Next -->
    {
      currentPage < totalPages && (
        <li>
          <a href={getPageUrl(currentPage + 1)} class="px-3 py-1 border rounded hover:bg-gray-100">
            Next
          </a>
        </li>
      )
    }
  </ul>
</nav>
