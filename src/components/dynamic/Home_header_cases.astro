---
import type { Home_header_casesProps } from '../../types/components';
const {Home_header_cases} = Astro.props as Home_header_casesProps;
---


<div class="mb-10 md:mb-16">
  <h2
    class="mb-4 text-center text-2xl font-bold text-gray-800 md:mb-6 lg:text-3xl"
  >
    {Home_header_cases.title}
  </h2>

  <p class="mx-auto max-w-screen-md text-center text-gray-500 md:text-lg">
    {Home_header_cases.subtitle}
  </p>
</div>
