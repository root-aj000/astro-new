---
import type { BlogCard } from '../../types/components.ts';
const {blog_data} = Astro.props as BlogCard;
---

<a href={blog_data.href} class="block group cursor-pointer border border-gray-300 rounded-2xl p-5 transition-all duration-300 hover:border-indigo-600 hover:bg-gray-100">
  <div class="flex items-center mb-6">
    <img src={blog_data.image} alt={blog_data.title} class="rounded-lg w-full object-cover" />
  </div>
  <div>
    <h4 class="text-gray-900 font-medium leading-8 mb-9">
      {blog_data.title}
    </h4>
    <div class="flex items-center justify-between font-medium">
      <h6 class="text-sm text-gray-500">By {blog_data.author}</h6>
      <span class="text-sm text-indigo-600">
        {new Date(blog_data.date).toLocaleDateString(undefined, {
          year: 'numeric',
          month: 'short',
          day: 'numeric',
        })}
      </span>
    </div>
  </div>
</a>
