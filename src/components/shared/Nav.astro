<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title></title>
    <!-- <link rel="stylesheet" href="/src/styles/global.css" /> -->
    <script src="https://cdn.tailwindcss.com"></script>
  </head>

  <body class="bg-gray-100">
    <!-- Navbar -->
    <nav class="bg-white shadow-md relative">
      <div
        class="max-w-7xl mx-auto px-4 flex justify-between items-center h-16"
      >
        <a href="#" class="text-xl font-bold">Logo</a>

        <!-- Desktop Menu -->
        <div class="hidden lg:flex space-x-8 items-center">
          <button id="productsBtn" class="px-3 py-2 text-gray-700 font-medium">
            Products
          </button>
          <a href="#" class="px-3 py-2 text-gray-700">About</a>
          <a href="#" class="px-3 py-2 text-gray-700">Contact</a>
          <button id="productsBtn1" class="px-3 py-2 text-gray-700 font-medium">
            Products1
          </button>
        </div>

        <!-- Hamburger (small screens) -->
        <div class="lg:hidden">
          <button id="hamburger" class="text-gray-700 focus:outline-none">
            &#9776;
          </button>
        </div>

        <!-- UN COMMIT WHEN NEEDED LOGIN BUTTON -->
        <!-- <div class="hidden lg:flex space-x-8 items-center">
        <a href="#" class="font-bold">Login</a>
        <a href="#" class="font-bold">Contact us</a>
        </div> -->
      </div>

      <!-- Mega Menu (full-width, centered) -->
      <div
        id="megaMenu"
        class="absolute top-full left-1/2 transform -translate-x-1/2 mt-0
         w-full max-w-7xl bg-white shadow-lg p-6
         opacity-0 invisible transition-opacity duration-300 z-50
         flex gap-6"
      >
        <!-- Tabs -->
        <div
          class="flex flex-col space-y-3 border-r border-gray-400 pr-4 w-40 shrink-0"
        >
          <button
            class="tab-btn text-gray-700 font-medium border-l-4 border-transparent pl-3
             hover:border-blue-500 text-left break-words whitespace-normal"
            data-tab="tab1"
          >
            Tab 1 very very long text wrapping works fine now
          </button>
          <button
            class="tab-btn text-gray-700 font-medium border-l-4 border-transparent pl-3
             hover:border-blue-500 text-left break-words whitespace-normal"
            data-tab="tab2"
          >
            Tab 2
          </button>
          <button
            class="tab-btn text-gray-700 font-medium border-l-4 border-transparent pl-3
             hover:border-blue-500 text-left break-words whitespace-normal"
            data-tab="tab3"
          >
            Tab 3
          </button>
        </div>

        <!-- Tab Content -->
        <div class="flex-1">
          <div id="tab1" class="tab-content grid grid-cols-3 gap-6">
            <div class="p-4 border rounded-lg hover:bg-gray-50">
              <h3 class="font-semibold text-lg mb-2">Feature A1</h3>
              <p class="text-gray-600 text-sm">Content for Tab 1</p>
            </div>
            <!-- more features -->
          </div>

          <div id="tab2" class="tab-content hidden grid grid-cols-3 gap-6">
            <div class="p-4 border rounded-lg hover:bg-gray-50">
              <h3 class="font-semibold text-lg mb-2">Feature B1</h3>
              <p class="text-gray-600 text-sm">Content for Tab 2</p>
            </div>
          </div>

          <div id="tab3" class="tab-content hidden grid grid-cols-3 gap-6">
            <div class="p-4 border rounded-lg hover:bg-gray-50">
              <h3 class="font-semibold text-lg mb-2">Feature C1</h3>
              <p class="text-gray-600 text-sm">Content for Tab 3</p>
            </div>
          </div>
        </div>
      </div>

      <div
        id="megaMenu1"
        class="absolute top-full left-1/2 transform -translate-x-1/2 mt-0 w-full max-w-7xl bg-white shadow-lg p-6 grid grid-cols-3 gap-6 opacity-0 invisible transition-opacity duration-300 z-50"
      >
        <div class="p-4 border rounded-lg hover:bg-gray-50">
          <h3 class="font-semibold text-lg mb-2">Feature 11</h3>
          <p class="text-gray-600 text-sm">Description 11</p>
        </div>
        <div class="p-4 border rounded-lg hover:bg-gray-50">
          <h3 class="font-semibold text-lg mb-2">Feature 22</h3>
          <p class="text-gray-600 text-sm">Description 22</p>
        </div>
        <div class="p-4 border rounded-lg hover:bg-gray-50">
          <h3 class="font-semibold text-lg mb-2">Feature 33</h3>
          <p class="text-gray-600 text-sm">Description 33</p>
        </div>
      </div>

      <!-- Mobile Menu -->
      <div
        id="mobile-menu"
        class="lg:hidden absolute top-full left-0 w-full bg-white shadow-lg hidden"
      >
        <a href="#" class="block px-4 py-3 border-b">Products</a>
        <a href="#" class="block px-4 py-3 border-b">About</a>
        <a href="#" class="block px-4 py-3 border-b">Contact</a>
      </div>
    </nav>
    <!-- Mega Menu with Tabs -->

    <script>
      const tabButtons = document.querySelectorAll(".tab-btn");
      const tabContents = document.querySelectorAll(".tab-content");

      // Activate first tab by default
      tabButtons[0].classList.add("border-blue-500", "text-blue-600");
      tabContents[0].classList.remove("hidden");

      // Tab switching
      tabButtons.forEach((btn) => {
        btn.addEventListener("click", () => {
          const target = btn.getAttribute("data-tab");

          // Reset all
          tabButtons.forEach((b) =>
            b.classList.remove("border-blue-500", "text-blue-600")
          );
          tabContents.forEach((c) => c.classList.add("hidden"));

          // Activate selected
          btn.classList.add("border-blue-500", "text-blue-600");
          document.getElementById(target).classList.remove("hidden");
        });
      });

      const productsBtn = document.getElementById("productsBtn");
      const productsBtn1 = document.getElementById("productsBtn1");
      const megaMenu = document.getElementById("megaMenu");
      const megaMenu1 = document.getElementById("megaMenu1");
      const hamburger = document.getElementById("hamburger");
      const mobileMenu = document.getElementById("mobile-menu");

      // Helper function to attach hover + click behavior
      function setupMegaMenu(button, menu) {
        let timeout;

        function showMenu() {
          clearTimeout(timeout);
          menu.classList.remove("opacity-0", "invisible");
          menu.classList.add("opacity-100", "visible");
        }

        function hideMenu(delay = 200) {
          timeout = setTimeout(() => {
            menu.classList.remove("opacity-100", "visible");
            menu.classList.add("opacity-0", "invisible");
          }, delay);
        }

        // Hover events
        button.addEventListener("mouseenter", showMenu);
        button.addEventListener("mouseleave", () => hideMenu(100)); // close delay 3s
        menu.addEventListener("mouseenter", showMenu);
        menu.addEventListener("mouseleave", () => hideMenu(100));

        // Click toggle
        button.addEventListener("click", () => {
          if (menu.classList.contains("opacity-100")) {
            hideMenu(0); // Close immediately if open
          } else {
            showMenu(); // Open if closed
          }
        });
      }

      // Setup both mega menus
      setupMegaMenu(productsBtn, megaMenu);
      setupMegaMenu(productsBtn1, megaMenu1);

      // Mobile menu toggle
      hamburger.addEventListener("click", () => {
        mobileMenu.classList.toggle("hidden");
      });
    </script>
  </body>
</html>
