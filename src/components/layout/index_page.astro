---
import Base from "../layout/base.astro";
import Hero from "../dynamic/hero_1.astro";
import Cloud from "../dynamic/logo_cloud.astro";
import Hero_2 from "../dynamic/hero_2.astro";
import Hero_3 from "../dynamic/hero_3.astro";
import Hero4 from "../dynamic/hero_4.astro";
import ServicesHome from "../dynamic/services_home.astro";
import Stats from "../dynamic/stats.astro";
import BlogGrid from "../blog/blog-grid.astro";
import HomeHeaderBlog from "../dynamic/Home_header_blog.astro";
import CaseGrid from "../case/case-study-grid.astro";
import HomeHeaderCases from "../dynamic/Home_header_cases.astro";
import UniversalCard from "../dynamic/universal_card.astro";
// Removed getCollection import as fetching is done in the page
// import { getCollection } from 'astro:content';
import type { IndexProps } from "../../types/components";
import type { CollectionEntry } from 'astro:content'; // Import CollectionEntry type

interface IndexPageProps {
  indexpro: IndexProps['indexpro'];
  selectedPosts: CollectionEntry<'AichatbotBlog' | 'CloudComputingBlog' | 'CustomMLBlog' | 'DevopsBlog'>[]; // Adjust collection names as needed
  selectedCases: CollectionEntry<'AichatbotCases' | 'CloudComputingCases' | 'CustomMLCases' | 'DevopsCases'>[]; // Adjust collection names as needed
}

// Destructure the new props
const { indexpro, selectedPosts, selectedCases } = Astro.props as IndexPageProps;

// Removed data fetching logic as it is now in src/pages/index.astro
---

<Base>
  <Hero {...indexpro.hero} />
  <Cloud {...indexpro.cloud_data} />
  <Hero_2 {...indexpro.hero_2} />
  <Hero_3 {...indexpro.hero_3} />
  <ServicesHome {...indexpro.grid} />



  <!-- for casestudy max 3, 1 of each -->
  <HomeHeaderCases {...indexpro.Home_header_cases} />

  <CaseGrid>
    {
      selectedCases.map((caseStudy) => (
        <UniversalCard blog_data={caseStudy.data.case_data} />
      ))
    }
  </CaseGrid>



  <Stats {...indexpro.stats} />



  <!-- for blogs max 4, 1 of each -->
  <HomeHeaderBlog {...indexpro.Home_header_blog} />

  <BlogGrid>
    {
      selectedPosts.map((post) => (
        <UniversalCard blog_data={post.data.blog_data} />
      ))
    }
  </BlogGrid>


  <Hero4 {...indexpro.hero_4} />
</Base>
