---
import Base from "../layout/base.astro";
import Hero from "../dynamic/hero_1.astro";
import Hero_4 from "../dynamic/hero_4.astro";
import Cloud from "../dynamic/logo_cloud.astro";
import HowItWorks from "../dynamic/how_it_works.astro";
import ForWhom from "../dynamic/for_whom.astro";
import Features from "../dynamic/FeatureLR.astro";
import Stats from "../dynamic/stats.astro";
import BlogGrid from "../blog/blog-grid.astro";
import HomeHeaderBlog from "../dynamic/Home_header_blog.astro";
import CaseGrid from "../case/case-study-grid.astro";
import HomeHeaderCases from "../dynamic/Home_header_cases.astro";
import UniversalCard from "../dynamic/universal_card.astro";
import { enrichEntry } from "../../utils/enrich";// props
import type { IndexProps } from "../../types/components";
import type { CollectionEntry } from 'astro:content'; // Import CollectionEntry type

interface ServicePageProps {
  indexpro: IndexProps['indexpro'];
  limitedPosts: CollectionEntry<'AichatbotBlog' | 'CloudComputingBlog' | 'CustomMLBlog' | 'DevopsBlog'>[]; // Adjust collection names as needed
  limitedCases: CollectionEntry<'AichatbotCases' | 'CloudComputingCases' | 'CustomMLCases' | 'DevopsCases'>[]; // Adjust collection names as needed
}

const { indexpro, limitedPosts, limitedCases } = Astro.props as ServicePageProps;

---

<Base>
  <Hero hero ={indexpro.hero} />
  <Cloud logo_cloud ={indexpro.logo_cloud} />
  <HowItWorks Howitworks ={indexpro.Howitworks} />
  <ForWhom forwhom ={indexpro.forwhom} />
  <Features featurelr ={indexpro.featurelr} />
  <HomeHeaderCases Home_header_cases ={indexpro.Home_header_cases} />
  <CaseGrid>
    {
      limitedCases.map((caseStudy) => (
        <UniversalCard blog_data={enrichEntry(caseStudy)} />
      ))
    }
  </CaseGrid>

  <Stats stats ={indexpro.stats} />
  <HomeHeaderBlog Home_header_blog={indexpro.Home_header_blog} />
  <BlogGrid>
    {
      limitedPosts.map((post) => (
        <UniversalCard blog_data={enrichEntry(post)} />
      ))
    }
  </BlogGrid>
  <Hero_4 hero_4={indexpro.hero_4} />
</Base>
